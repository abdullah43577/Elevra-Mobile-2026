EXPO_PUBLIC_API_URL=''

# RevenueCat SDK key. Public by design — it ships inside the app bundle, so it
# is not a secret. Use the Test Store key in development; a release build
# configured with one deliberately crashes on launch.
EXPO_PUBLIC_REVENUE_CAT=''

# --- Social sign-in ---------------------------------------------------------
# OAuth client ids, not secrets: they ship inside the app bundle. The server
# holds the same values and checks every ID token's audience against them.

# The *web* client id, on every platform. Counter-intuitive but correct: the
# native SDKs ask Google for an idToken audienced to the web/"server" client,
# which is what the backend then verifies. Required for Google on Android too.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=''

# iOS only, from the iOS OAuth client.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=''

# The iOS client id with its dot-segments reversed, e.g.
# com.googleusercontent.apps.624604852794-abc123. Read at config time by
# app.config.js — changing it needs a native rebuild, not a reload.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=''
